{
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"$DEVIN_PROJECT_DIR\"/.devin/skills/build/spec-check.sh --hook"
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"$DEVIN_PROJECT_DIR\"/.devin/skills/build/log-event.sh prompt"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"$DEVIN_PROJECT_DIR\"/.devin/skills/build/log-event.sh tool"
        }
      ]
    }
  ]
}

